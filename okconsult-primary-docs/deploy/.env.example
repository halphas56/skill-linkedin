# Первинка — приклад оточення. Скопіювати у .env і заповнити реальними значеннями.
# .env у git не потрапляє. Жоден із цих ключів не має з'являтися в експортах
# workflow, у скриншотах, у листуванні з клієнтом і в промптах моделі.

# ---------------------------------------------------------------- база даних
POSTGRES_USER=pervynka
POSTGRES_PASSWORD=change_me_32_chars_min
POSTGRES_DB=pervynka

# ------------------------------------------------------------------- n8n
# Згенерувати: openssl rand -hex 32
# Бекапити ОКРЕМО від дампа бази: без цього ключа credentials не розшифруються.
N8N_ENCRYPTION_KEY=change_me_openssl_rand_hex_32
N8N_HOST=pervynka.ok-consult.ua
# Згенерувати: docker run --rm caddy caddy hash-password --plaintext '<пароль>'
N8N_BASIC_AUTH_HASH=$2a$14$replace_with_real_bcrypt_hash
REDIS_PASSWORD=change_me_24_chars_min

# ------------------------------------------------------------------ Anthropic
# Кладеться не сюди, а в credentials n8n «Anthropic API (x-api-key)»
# (Header Auth, заголовок x-api-key). Тут — лише для довідки.
# ANTHROPIC_API_KEY=sk-ant-...

# --------------------------------------------------------- промпти і схеми
# Вміст файлів prompts/*.md (без обгортки ```text) і schemas/*.json одним рядком.
# Зручніше зберігати їх у credentials/змінних n8n, ніж перезбирати контейнер.
PROMPT_EXTRACT=<вміст prompts/prompt-extract-document.md>
PROMPT_MATCH=<вміст prompts/prompt-match-nomenclature.md>
PROMPT_BANK=<системний промпт зіставлення платежів>
SCHEMA_EXTRACT=<вміст schemas/extract-document.schema.json одним рядком>

# ----------------------------------------------------------------- Вчасно
# Ключ береться в кабінеті Вчасно.ЕДО. Кладеться в credentials
# «Вчасно API (ApiKey)» як Header Auth.
# VCHASNO_API_KEY=...

# ------------------------------------------------------- Приват24 для бізнесу
# Сервіс «Автоклієнт» → створити застосунок типу API.
P24_CLIENT_ID=replace_me
P24_TOKEN=replace_me
P24_IBAN=UA000000000000000000000000000

# --------------------------------------------------------------- приймання пошти
# Спільний секрет, який inbound-parse провайдер шле в заголовку X-Intake-Secret.
# Вчасно/Mailgun/SendGrid підпису не дають — тому непублічний шлях вебхука
# плюс цей секрет.
INBOUND_SHARED_SECRET=change_me_random_40_chars

# ---------------------------------------------------------------- алерти
# ID чату, куди йдуть помилки й алерт про тишу. Токен бота — в credentials.
ALERT_CHAT_ID=-1000000000000

# ------------------------------------------------------- межі автоматизації
# Документи, дорожчі за цю суму, ніколи не йдуть в авто-проведення —
# вони завжди проходять через людину. Це налаштування, а не константа в коді.
AUTO_LIMIT_UAH=100000
